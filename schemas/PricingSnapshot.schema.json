{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PricingSnapshot.schema.json",
  "title": "PricingSnapshot",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "fetchedAt": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "path",
        "commit",
        "url",
        "fetchedAt"
      ],
      "additionalProperties": false
    },
    "keptRateKeyPattern": {
      "type": "string"
    },
    "models": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "rates": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "provider",
          "mode",
          "rates"
        ],
        "additionalProperties": false
      }
    },
    "leftOut": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "model",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "date",
    "source",
    "keptRateKeyPattern",
    "models",
    "leftOut"
  ],
  "additionalProperties": false
}
