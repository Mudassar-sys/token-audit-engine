                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "requests": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "tokens": {
                "type": "object",
                "properties": {
                  "uncachedInput": {
                    "type": "number"
                  },
                  "cacheRead": {
                    "type": "number"
