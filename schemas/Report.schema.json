    "provenance": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string"
        },
        "fileBytes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "variant": {
          "type": "string",
          "enum": [
            "A-json",
            "A-jsonl",
            "B-json",
            "B-jsonl",
            "C-page",
            "D-json",
            "D-jsonl",
            "E-json",
            "E-jsonl",
            "F-csv",
            "F-json",
            "G-otlp",
            "G-otlp-jsonl",
            "H-csv"
          ]
        },
        "detection": {
          "type": "object",
