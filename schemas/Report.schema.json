    "totals": {
      "type": "object",
      "properties": {
        "value": {
          "type": "object",
          "properties": {
            "exactUsd": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            "displayUsd": {
              "type": "string"
            }
          },
          "required": [
            "exactUsd",
            "displayUsd"
          ],
          "additionalProperties": false
        },
        "measuredCharge": {
          "type": "object",
          "properties": {
            "exactUsd": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            "displayUsd": {
              "type": "string"
            }
          },
          "required": [
            "exactUsd",
            "displayUsd"
          ],
          "additionalProperties": false
        },
        "estimated": {
          "type": "object",
          "properties": {
            "exactUsd": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
