                  "required": [
                    "timestamp",
                    "provider",
                    "model",
                    "inputTokens",
                    "inputIncludesCached",
                    "cacheRead",
                    "cacheWrite",
                    "cacheWriteDuration",
                    "outputTokens",
                    "reasoningTokens",
                    "tier",
                    "reportedCharge"
                  ],
                  "additionalProperties": false
