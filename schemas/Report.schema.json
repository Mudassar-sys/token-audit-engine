                  "cacheWrite": {
                    "type": "number"
                  },
                  "output": {
                    "type": "number"
                  },
                  "reasoning": {
                    "type": "number"
                  }
                },
                "required": [
                  "uncachedInput",
                  "cacheRead",
                  "cacheWrite",
                  "output",
