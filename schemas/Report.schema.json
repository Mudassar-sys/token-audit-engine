{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Report.schema.json",
  "title": "Report",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "const": "Token cost audit report"
    },
    "engineVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "exportedAt": {
      "type": "string"
    },
    "calculationIdentity": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "properties": {
            "inputFileSha256": {
              "type": "string"
            },
            "mapping": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "timestamp": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "provider": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "model": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "inputTokens": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "inputIncludesCached": {
                      "type": "boolean"
                    },
                    "cacheRead": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "cacheWrite": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "cacheWriteDuration": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "5m",
                            "1h",
                            "30m",
                            "12h"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "outputTokens": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reasoningTokens": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "tier": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reportedCharge": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
