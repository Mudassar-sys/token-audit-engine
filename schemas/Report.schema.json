            "variant": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "A-json",
                    "A-jsonl",
                    "B-json",
                    "B-jsonl",
                    "C-page",
                    "D-json",
                    "D-jsonl",
                    "E-json",
                    "E-jsonl",
                    "F-csv",
                    "F-json",
                    "G-otlp",
                    "G-otlp-jsonl",
                    "H-csv"
                  ]
                },
                {
                  "type": "null"
