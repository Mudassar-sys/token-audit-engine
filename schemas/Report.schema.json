            "adapters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "version"
                ],
                "additionalProperties": false
              }
            },
            "schemaVersion": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "snapshotSha256": {
              "type": "string"
            },
            "baselineModel": {
              "type": [
                "string",
                "null"
              ]
            },
            "routing": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "sourceModels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "inputBands": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "targetModel": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "eligibleShare": {
                      "type": "string",
                      "pattern": "^-?\\d+(\\.\\d+)?$"
                    },
                    "outputLengthRatio": {
                      "type": "string",
                      "pattern": "^-?\\d+(\\.\\d+)?$"
                    },
                    "tokenizerRatio": {
                      "type": "string",
                      "pattern": "^-?\\d+(\\.\\d+)?$"
                    },
                    "retryFallbackRate": {
                      "type": "string",
                      "pattern": "^-?\\d+(\\.\\d+)?$"
                    },
                    "routingOverheadTokens": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "calibrationPassRate": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^-?\\d+(\\.\\d+)?$"
