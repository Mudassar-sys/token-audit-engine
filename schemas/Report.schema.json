            "reportSettings": {
              "type": "object",
              "properties": {
                "displayDecimals": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 15
                },
                "aggregateKeyCap": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "displayDecimals",
                "aggregateKeyCap"
