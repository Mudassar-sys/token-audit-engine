                "maximum": 9007199254740991
              },
              "requests": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "tokens": {
                "type": "object",
                "properties": {
                  "uncachedInput": {
                    "type": "number"
                  },
                  "cacheRead": {
                    "type": "number"
                  },
                  "cacheWrite": {
                    "type": "number"
                  },
                  "output": {
                    "type": "number"
                  },
                  "reasoning": {
                    "type": "number"
                  }
                },
                "required": [
                  "uncachedInput",
                  "cacheRead",
                  "cacheWrite",
                  "output",
                  "reasoning"
                ],
                "additionalProperties": false
              },
              "valueUsd": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              },
              "rowsNotPriced": {
                "type": "integer",
