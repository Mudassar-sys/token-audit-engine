{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AuditRow.schema.json",
  "title": "AuditRow",
  "type": "object",
  "properties": {
    "rowIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "variant": {
      "type": "string",
      "enum": [
        "A-json",
        "A-jsonl",
        "B-json",
        "B-jsonl",
        "C-page",
        "D-json",
        "D-jsonl",
        "E-json",
        "E-jsonl",
        "F-csv",
        "F-json",
        "G-otlp",
        "G-otlp-jsonl",
        "H-csv"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "modelLogged": {
      "type": [
        "string",
        "null"
      ]
    },
    "tierStated": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "standard",
            "batch",
            "flex",
            "priority",
            "ultrafast"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "granularity": {
      "type": "string",
      "enum": [
        "request",
        "time_bucket"
      ]
    },
    "tokens": {
      "type": "object",
      "properties": {
        "uncachedInput": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheRead": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheWrite": {
          "type": "object",
          "properties": {
            "5m": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "1h": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "30m": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "12h": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "5m",
            "1h",
            "30m",
            "12h"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "uncachedInput",
        "cacheRead",
        "cacheWrite",
        "output",
        "reasoning"
      ],
      "additionalProperties": false
    },
    "notMeasured": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "reported": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "amountUsd": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            "field": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "charge",
                "gateway_estimate"
              ]
            }
          },
          "required": [
            "amountUsd",
            "field",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "raw": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "mapping": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tier_assumed",
          "duration_assumed",
          "inclusion_assumed",
          "inclusion_detected",
          "long_context_applied",
          "long_context_not_applied_bucket",
          "totals_disagree",
          "cache_exceeds_input",
          "aggregate_span",
          "overlaps_child_in_row_counts",
          "aggregate_mismatch",
          "cost_inconsistent",
          "malformed",
          "model_missing",
          "billed_class_missing",
          "estimate_incomplete"
        ]
      }
    },
    "unresolvedReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "counted": {
      "type": "boolean"
    },
    "requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "operation": {
      "type": "string",
      "enum": [
        "generate",
        "embedding"
      ]
    },
    "resolvedKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "match": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exact",
            "alias",
            "none"
          ]
        },
        "detail": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "detail",
        "source"
      ],
      "additionalProperties": false
    },
    "tierApplied": {
      "type": "string",
      "enum": [
        "standard",
        "batch",
        "flex",
        "priority",
        "ultrafast"
      ]
    },
    "cost": {
      "type": "object",
      "properties": {
        "valueUsd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Measured",
                "Measured charge",
                "Estimated",
                "Not measured",
                "Not priced",
                "Unresolved"
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        },
        "estimateUsd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimateLabel": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Measured",
                "Measured charge",
                "Estimated",
                "Not measured",
                "Not priced",
                "Unresolved"
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        },
        "appliedRates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tokenClass": {
                "type": "string"
              },
              "tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "rateKey": {
                "type": "string"
              },
              "rateUsdPerToken": {
                "type": "string"
              },
              "costUsd": {
                "type": "string"
              }
            },
            "required": [
              "tokenClass",
              "tokens",
              "rateKey",
              "rateUsdPerToken",
              "costUsd"
            ],
            "additionalProperties": false
          }
        },
        "formula": {
          "type": "string"
        }
      },
      "required": [
        "valueUsd",
        "label",
        "estimateUsd",
        "estimateLabel",
        "appliedRates",
        "formula"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "Measured",
              "Measured charge",
              "Estimated",
              "Not measured",
              "Not priced",
              "Unresolved"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "date",
        "sha256",
        "commit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "rowIndex",
    "timestamp",
    "variant",
    "provider",
    "modelLogged",
    "tierStated",
    "granularity",
    "tokens",
    "notMeasured",
    "excluded",
    "reported",
    "raw",
    "mapping",
    "flags",
    "unresolvedReason",
    "counted",
    "requests",
    "resolvedKey",
    "match",
    "tierApplied",
    "cost",
    "labels",
    "snapshot"
  ],
  "additionalProperties": false
}
