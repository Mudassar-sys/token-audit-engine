{
  "name": "token-audit-engine",
  "version": "1.0.0",
  "description": "Browser-only token-cost audit engine, built as a working demonstration for a token-cost audit requirement.",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/engine-fingerprint.ts && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pricing:refresh": "tsx scripts/refresh-pricing.ts",
    "pricing:validate": "tsx scripts/validate-pricing.ts",
    "schemas": "tsx scripts/export-schemas.ts",
    "fingerprint": "tsx scripts/engine-fingerprint.ts",
    "predev": "tsx scripts/engine-fingerprint.ts",
    "prepreview": "tsx scripts/engine-fingerprint.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@streamparser/json": "^0.0.26",
    "@tanstack/react-virtual": "^3.14.24",
    "idb": "^8.0.4",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "lossless-json": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "private": true
}
